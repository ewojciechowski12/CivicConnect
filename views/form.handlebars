<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="utf-8"> 
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=yes">
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
<link rel="stylesheet" href="/stylesheets/style.css">
<title>Carthage Civic Connect</title>
    <link rel="icon" type="image/x-icon" href="/images/bookflame.png">
</head>

<header class="header" style="margin:0px;margin-bottom:1%">
  <div class="logo-left">
    <a href="https://www.carthage.edu/" tabindex="1">
    <img src="./images/bookmark.png" alt="Logo Left" height="125px">
    </a>
  </div>
  <div class="title-description" style="overflow: hidden">
    <h1 class="title" style="overflow: hidden">Carthage College Civic Connect</h1>
    <p class="description">Fill out the form below to submit a project proposal</p>
  </div>
  <div class="logout-right" >
    <img src=".\images\bookflame.png" alt="Logo right" height="100px">
  </div>    
</header>



<body>
<form action="/project" method="post" enctype="application/x-www-form-urlencoded" class="basic-form">
    
  <div class="form-group">
    <p class="form-intro">
      <strong>Welcome to Civic Connect!</strong> This form is for community organizations 
      interested in partnering with Carthage College on a project. By submitting a request, 
      you'll be connected with faculty and students who are willing to help. Once submitted, your request will 
      be reviewed by the relevant Carthage department, and a faculty member will follow up with 
      you directly. Please fill out all fields as completely as possible so we can match you 
      with the right team.
    </p>
  </div>

  <div class="form-group">
    <label for="fname">First Name:</label>
    <input selected type="text" id="fname" name="fname" tabindex="2" required>
  </div>

  <div class="form-group">
    <label for="lname" class="label-style">Last Name:</label>
    <input type="text" id="lname" name="lname" tabindex="3" required>
  </div>

  <div class="form-group">
    <label for="OrgName" class="label-style">Business/Organization Name:</label>
    <input type="text" id="OrgName" name="OrgName" tabindex="4" required>
  </div>
  
  <div class="form-group">
    <label for="email" class="label-style">Contact Email:</label>
    <input type="text" id="email" name="email" tabindex="5" required>
  </div>

  <div class="form-group">
    <label for="pNumber" class="label-style">Phone Number:</label>
    <input type="text" id="pNumber" name="pNumber" tabindex="6" required>
  </div>

  <div class="form-group">
    <label for="streetAddr" class="label-style">Street Address: (of Business/Org)</label>
    <input type="text" id="streetAddr" name="streetAddr" tabindex="7" required>
  </div>

  <div class="form-group">
    <label for="cityTown" class="label-style">City/Town:</label>
    <input type="text" id="cityTown" name="cityTown" tabindex="8" required>
  </div>  
    
  <div class="form-group">
     <select id="state" name="state" class="dropdown-toggle" required>               
        <option class="dropdown-item" selected="selected" hidden="hidden">State</option>
        <option class="dropdown-item" value="alabama">Alabama</option>
        <option class="dropdown-item" value="alaska">Alaska</option>
        <option class="dropdown-item" value="arizona">Arizona</option>
        <option class="dropdown-item" value="arkansas">Arkansas</option>
        <option class="dropdown-item" value="california">California</option>
        <option class="dropdown-item" value="colorado">Colorado</option>
        <option class="dropdown-item" value="connecticut">Connecticut</option>
        <option class="dropdown-item" value="delaware">Delaware</option>
        <option class="dropdown-item" value="florida">Florida</option>
        <option class="dropdown-item" value="georgia">Georgia</option>
        <option class="dropdown-item" value="hawaii">Hawaii</option>
        <option class="dropdown-item" value="idaho">Idaho</option>
        <option class="dropdown-item" value="illinois">Illinois</option>
        <option class="dropdown-item" value="indiana">Indiana</option>
        <option class="dropdown-item" value="iowa">Iowa</option>
        <option class="dropdown-item" value="kansas">Kansas</option>
        <option class="dropdown-item" value="kentucky">Kentucky</option>
        <option class="dropdown-item" value="louisiana">Louisiana</option>
        <option class="dropdown-item" value="maine">Maine</option>
        <option class="dropdown-item" value="maryland">Maryland</option>
        <option class="dropdown-item" value="massachusetts">Massachusetts</option>
        <option class="dropdown-item" value="michigan">Michigan</option>
        <option class="dropdown-item" value="minnesota">Minnesota</option>
        <option class="dropdown-item" value="mississippi">Mississippi</option>
        <option class="dropdown-item" value="missouri">Missouri</option>
        <option class="dropdown-item" value="montana">Montana</option>
        <option class="dropdown-item" value="nebraska">Nebraska</option>
        <option class="dropdown-item" value="nevada">Nevada</option>
        <option class="dropdown-item" value="new-hampshire">New Hampshire</option>
        <option class="dropdown-item" value="new-jersey">New Jersey</option>
        <option class="dropdown-item" value="new-mexico">New Mexico</option>
        <option class="dropdown-item" value="new-york">New York</option>
        <option class="dropdown-item" value="north-carolina">North Carolina</option>
        <option class="dropdown-item" value="north-dakota">North Dakota</option>
        <option class="dropdown-item" value="ohio">Ohio</option>
        <option class="dropdown-item" value="oklahoma">Oklahoma</option>
        <option class="dropdown-item" value="oregon">Oregon</option>
        <option class="dropdown-item" value="pennsylvania">Pennsylvania</option>
        <option class="dropdown-item" value="rhode-island">Rhode Island</option>
        <option class="dropdown-item" value="south-carolina">South Carolina</option>
        <option class="dropdown-item" value="south-dakota">South Dakota</option>
        <option class="dropdown-item" value="tennessee">Tennessee</option>
        <option class="dropdown-item" value="texas">Texas</option>
        <option class="dropdown-item" value="utah">Utah</option>
        <option class="dropdown-item" value="vermont">Vermont</option>
        <option class="dropdown-item" value="virginia">Virginia</option>
        <option class="dropdown-item" value="washington">Washington</option>
        <option class="dropdown-item" value="west-virginia">West Virginia</option>
        <option class="dropdown-item" value="wisconsin">Wisconsin</option>
        <option class="dropdown-item" value="wyoming">Wyoming</option>                  
    </select>
  </div>

  <div class="form-group">
    <label for="zip" class="label-style">Zip Code:</label>
    <input type="text" id="zip" name="zip" class="length1" tabindex="10" required>
  </div>

  <div class="form-group">
    <label for="OrgSite" class="label-style">Website of Business/Org:</label>
    <input type="text" id="OrgSite" name="OrgSite" class="length3" tabindex="11"> 
  </div>
    
  <div class="form-group">
    <label for="Description" class="label-style">Project Description:</label>
    <textarea class="description" id="Description" name="Description" onfocus="this.focus();this.select();"
      tabindex="15"></textarea>
  </div>

  <div class="form-group">
    <label for="startDate" class="label-style">Anticipated Start Date:</label>    
    <input type="date" id="startDate" name="startDate" required>
  </div>

  <div class="form-group">
    <label for="endDate" class="label-style">Anticipated Completion Date:</label>    
    <input type="date" id="endDate" name="endDate" required>
  </div>

  <div class="form-group">
    <label for="department" class="label-style">Select Relevant Department(s) For This Project: (CTRL click to select multiple):</label>
    <select name="department" id="department" class="test-dropdown-select" tabindex="16" multiple required>               
      <!--####################################################################################################################################
      ########################################################################################################################################
    
                                            Code Break 1
    
      ########################################################################################################################################
      ########################################################################################################################################-->
      <option class="test-dropdown-option" value="1">Biology</option>
      <option class="test-dropdown-option" value="2">Carthage Honors Program</option>
      <option class="test-dropdown-option" value="3">Clinical/Counseling Psychology</option>
      <option class="test-dropdown-option" value="4">Computer Science</option>
      <option class="test-dropdown-option" value="5">Engineering</option>
      <option class="test-dropdown-option" value="6">Environmental Science</option>
      <option class="test-dropdown-option" value="7">GIS, mapping, spatial analytics</option>
      <option class="test-dropdown-option" value="8">Geoscience</option>
      <option class="test-dropdown-option" value="9">Graphic Design and Photography</option>
      <option class="test-dropdown-option" value="10">Healthcare pre-professions-Allied Health Science</option>
      <option class="test-dropdown-option" value="11">History</option>
      <option class="test-dropdown-option" value="12">Operations Management, Strategic Planning, Human Capital, and Start-Ups</option>
      <option class="test-dropdown-option" value="14">Public Relation (press releases, social media calendars, feature articles, event plans)</option>
      <option class="test-dropdown-option" value="15">Sociology & Criminal Justice</option>
      <option class="test-dropdown-option" value="13">Other</option>
      <!--####################################################################################################################################
      ########################################################################################################################################
    
                                            End of Code Break 1
    
      ########################################################################################################################################
      ########################################################################################################################################-->
    </select>     
  </div>
  <div class="form-group">
    <button type="submit" class="form-submit">Add Project</button>
  </div>

</form>
</body>
