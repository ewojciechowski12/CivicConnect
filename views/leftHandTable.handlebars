<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<form action="/faculty/Search" method="post" enctype="application/x-www-form-urlencoded" >
    <div class="table-header-container">
        
        <!-- Table Headers -->
        <div class="table-container">
            <table class="table-no-borders">
                <tr>                    
                        <th><a href="/faculty" id="allStatus" class="state">All({{allCount}})</a></th>
                        <th><a href="/faculty/status?status=Complete" class="state">Complete({{completeCount}})</a></th>
                        <th><a href="/faculty/status?status=Incomplete" class="state">Incomplete({{incompleteCount}})</a></th>
                        <th><a href="/faculty/status?status=Waiting" class="state">Waiting({{waitingCount}})</a></th>
                        <th>Archived</th>        
                    </tr>
            </table>
        </div>
        <!-- Search Bar -->
        <div class="search-container">
            <input type="text" id="Search" name="Search" class="length1"  tabindex="1">
            <button type="submit" tabindex="2">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </div>
</form>



<table class="table-striped table-hover table-interactive" overflow-y="hidden" > 
    <thead>         
        <tr>
            <th width="5%"><a href="/faculty/date" tabindex="1" class="noVisual">Project ID</a></th>
            <th width="8%"><a href="/faculty/company" tabindex="1" class="noVisual">Company</a></th>
            <th width="7%">Contact</th>
            <th width="40%">Description</th>
            <th width="10%"><a href="/faculty/date" tabindex="1" class="noVisual">Submission Date</a></th>
            <th width="10%"><a href="/faculty/status" tabindex="1" class="noVisual">Status</a></th>
            <th width="20%"><a href="/faculty/department" tabindex="1" class="noVisual">Department</a></th>
        </tr>
    </thead> 
 
 <!-- Table For all Projects on /faculty -->
    {{#each projects}} 
        <tr> 
            <td><a href="/allinformation/{{this/projectID}}" tabindex="1">{{this/projectID}}</a></td>
            <td>{{this/name}}</td> 
            <td>{{this/first}} {{this/last}}</td> 
            <td class="descrip-text"><a href="/allinformation/{{this/projectID}}" tabindex="1">{{this/Description}}</a></td>
            <td>{{this/Date}}</td>
            <td>{{this/pstatus}}</td>
            <td>{{this/depName}}</td>            
        </tr>
    {{/each}}
</table>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Get the current query parameter from the URL
        const urlParams = new URLSearchParams(window.location.search);
        const statusParam = urlParams.get('status');  // e.g. 'Complete', 'Incomplete', 'Waiting'

        // Get all the state links
        const states = document.querySelectorAll('.state');

        // If no status query parameter is present, set the 'All' link as selected by default
        if (!statusParam) {
            document.getElementById('allStatus').classList.add('selected');
        } else {
            // Loop through all the state links and add the 'selected' class to the correct one
            states.forEach(state => {
                const linkStatus = new URL(state.href).searchParams.get('status');
                if (linkStatus === statusParam) {
                    state.classList.add('selected');
                }
            });
        }

        // Add click event to each link to update the query parameter and refresh the page
        states.forEach(state => {
            state.addEventListener('click', function(event) {
                // Add 'selected' class to clicked link and remove from others
                states.forEach(s => s.classList.remove('selected'));
                state.classList.add('selected');
            });
        });
    });
</script>