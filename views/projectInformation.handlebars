<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Info</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
            color: #333;
        }

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 20px;
        }

        .btn {
            background-color: rgb(238, 42, 55);
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            text-decoration: none;
            display: inline-block;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            background-color: rgb(169, 36, 45);
        }

        .section {
            background-color: #fff;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
        }

        h2 {
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
            margin-bottom: 20px;
            color: #444;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }


        .col {
            flex: 1 1 300px;
            font-size: 18px;
        }

        a {
            color: #007BFF;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        table th, table td {
            padding: 12px 25px;
            border-bottom: 1px solid #ddd;
            vertical-align: middle;
        }

        table th {
            background-color: #f9f9f9;
            font-weight: 600;
            text-align: left;
        }

        table tr:hover {
            background-color: #f1f1f1;
        }

        form {
            margin-top: 30px;
        }        
        
        p {
            font-size: 18px;
        }
        .add-department-form {
            display: flex;
            align-items: center;
            gap: 10px; /* Adjust the space between the dropdown and button */
        }

        .add-department-form select {
            padding: 8px;
            font-size: 16px;
            width: 50%;
        }

        .add-department-form button {
            padding: 8px 16px;
            font-size: 16px;
            background-color: rgb(238, 42, 55);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .add-department-form button:hover {
            background-color: rgb(169, 36, 45);
        }

        .status-edit {
            display: flex; /* Initially hidden */
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }        

        .status-edit select {
            padding: 6px;
            font-size: 14px;
            width: 180px;
        }

        .status-edit .btn {
            padding: 6px 12px;
            font-size: 14px;
            background-color: rgb(238, 42, 55);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .status-edit .btn:hover {
            background-color: rgb(169, 36, 45);
        }

        .status-edit-toggle {
            margin-left: 10px;
            padding: 5px 10px;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="container">
        <a href="/faculty" class="btn">Back</a>

        <div class="section">
            <h2>Project Overview</h2>
            <div class="row">
                <div class="col"><strong>Project ID:</strong> {{information.0.projectID}}</div>

                <div class="col">
                    <strong>Status:</strong> 
                    <span id="status-text">{{information.0.pstatus}}</span>
                    <button type="button" onclick="toggleStatusEdit()" class="btn status-edit-toggle">Edit</button>

                    <form id="status-form" action="/allinformation/statusupdate/{{information.0.projectID}}" method="POST" class="status-edit"
                    style="display: none; margin-top: 10px;">
                        <select name="pStatus" required>                            
                            <option value="Complete">Complete</option>
                            <option value="Incomplete">Incomplete</option>
                            <option value="Waiting">Waiting</option>
                            <option value="Archived">Archive Project</option>
                        </select>
                        <button type="submit" class="btn">Save</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="section">
            <h2>Company Information</h2>
            <div class="row">
                <div class="col"><strong>Company Name:</strong> {{information.0.name}}</div>
                <div class="col"><strong>Contact:</strong> {{information.0.first}} {{information.0.last}}</div>
                <div class="col"><strong>Email:</strong> <a href="mailto:{{information.0.email}}">{{information.0.email}}</a></div>
            </div>
        </div>

        <div class="section">
            <h2>Additional Details</h2>
            <div class="row">
                <div class="col"><strong>Phone:</strong> {{information.0.phone}}</div>
                <div class="col"><strong>Anticipated End Date:</strong> {{information.0.endDate}}</div>
                <div class="col"><strong>Contact Availability:</strong> {{information.0.radio}} {{information.0.helpAvail}}</div>
            </div>
        </div>

        <div class="section">
            <h2>Location & Web</h2>
            <div class="row">
                <div class="col"><strong>Address:</strong> {{information.0.street}}, {{information.0.city}}, {{information.0.state}}, {{information.0.zip}}</div>
                <div class="col"><strong>Website:</strong> <a href="https://{{information.0.companyWeb}}" target="_blank">{{information.0.companyWeb}}</a></div>
                <div class="col"><strong>Submitted:</strong> {{information.0.createDate}}</div>
            </div>
        </div>

        <div class="section">
            <h2>Project Description</h2>
            <p>{{information.0.Description}}</p>
        </div>

        <div class="section">
            <h2>Departments Involved 
                <button type="button" class="add-btn" title="Add department" onclick="toggleDropdown()">
                    <i class="fas fa-plus"></i>
                </button>
                <div class="add-department-form" style="display: none; margin-top: 10px;">
                    <form action="/allinformation/addDep/{{information.0.projectID}}" method="POST">
                        <select name="departmentID" class="test-dropdown-select" required>
                        {{#each departments}}
                            <option value="{{this.departmentID}}">{{this.depName}}</option>
                        {{/each}}
                        </select>
                        <button type="submit" class="btn">Add</button>
                    </form>
                </div>
            </h2>
            
            <table>
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Chair</th>
                        <th>Email</th>
                        <th>Actions</th>                        
                    </tr>
                </thead>
                <tbody>
                    {{#each information}}
                        <tr>
                            <td>{{this.depName}}</td>
                            <td>{{this.head}}</td>
                            <td><a href="mailto:{{this.depEmail}}">{{this.depEmail}}</a></td>
                            <td>
                                <div class="button-group">
                                    <!--Remove Button-->
                                    <form action="/allinformation/deleteDep/{{this.projectID}}" method="POST">
                                        <input type="hidden" name="departmentID" value="{{this.departmentID}}" />
                                        <button type="submit" class="trash-btn">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>                                
                                </div>
                            </td>                            
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <form id="deleteForm" action="/allinformation/delete/{{information.0.projectID}}" method="POST" onsubmit="return confirmDelete()">
            <button type="submit" class="btn">Delete Project</button>
        </form>
    </div>
</body>
</html>

<script>
    const addBtn = document.querySelector('.add-btn');
    const addForm = document.querySelector('.add-department-form');  // Select the first element with this class

    // Toggle the visibility of the add department form
    addBtn.addEventListener('click', function (e) {
    e.preventDefault();
    addForm.style.display = addForm.style.display === 'none' ? 'block' : 'none';
    });

    // Project Deletion Confirmation logic
    function confirmDelete() {
        return confirm('Are you sure you want to delete this project?');
    }

    // Toggle the visibility of the status edit form
    const statusEditBtn = document.querySelector('.status-edit-toggle');
    const statusForm = document.getElementById('status-form');
    statusEditBtn.addEventListener('click', function (e) {
        e.preventDefault();        
        statusForm.style.display = statusForm.style.display === 'none' ? 'block' : 'none';
    }); 
    

</script>